---
import { SITE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="border-b border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-4 sm:px-6">
    <a href="/" class="mr-auto text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {SITE.title}
    </a>

    {/* Theme switch + hamburger. Sits after the nav on desktop, before it on mobile. */}
    <div class="order-2 flex items-center gap-3 sm:order-3">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="group -mr-1.5 rounded-md p-1.5 text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 sm:hidden dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
      >
        <svg class="size-5 group-aria-expanded:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="hidden size-5 group-aria-expanded:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    {/* Hidden on mobile until toggled; always visible from the sm breakpoint. */}
    <nav id="site-nav" aria-label="Main" class="order-3 hidden basis-full sm:order-2 sm:block sm:basis-auto">
      <ul class="flex flex-col gap-1 py-2 text-sm sm:flex-row sm:gap-x-5 sm:py-0">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'block py-1.5 transition-colors hover:text-zinc-900 sm:py-0 dark:hover:text-zinc-100',
                  isActive(href)
                    ? 'font-medium text-zinc-900 dark:text-zinc-100'
                    : 'text-zinc-600 dark:text-zinc-400',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('hidden', !open);
  });
</script>
