---
/**
 * Page title + optional intro paragraph, used at the top of each section page.
 */
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<header class="mb-10">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">{title}</h1>
  {intro && <p class="mt-3 max-w-prose text-lg text-zinc-600 dark:text-zinc-400">{intro}</p>}
</header>
