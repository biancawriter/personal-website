---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Page not found</h1>
  <p class="mt-4 text-zinc-600 dark:text-zinc-400">That page does not exist, or it moved.</p>
  <p class="mt-6"><a href="/" class="link">Back to the homepage</a></p>
</BaseLayout>
