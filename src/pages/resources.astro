---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { RESOURCES, STYLE_GUIDES, BOOKS, TOOLS } from '../data/resources';

type Item = { title: string; url: string; description: string; authors?: string };

const sections: { heading: string; intro?: string; items: readonly Item[] }[] = [
  { heading: 'Communities and People Worth Following', items: RESOURCES },
  {
    heading: 'Style Guides for Technical Writers',
    intro:
      "If you're just getting started in technical communication, I recommend becoming familiar with at least one tech writing style guide. Here are a few great ones.",
    items: STYLE_GUIDES,
  },
  {
    heading: 'Books on Writing',
    intro:
      'Required reading for any professional writers, not just technical communicators. These books shaped both the content I create and my approach to writing in general.',
    items: BOOKS,
  },
  { heading: 'Tools I Use', items: TOOLS },
];
---

<BaseLayout title="Resources" description="Communities, style guides, books, and tools Bianca Ragsdale recommends for technical writers.">
  <PageHeader title="Resources" intro="Resources I have found useful as a technical writer and that I recommend to others starting in technical communication." />

  {
    sections.map(({ heading, intro, items }) => (
      <section class="mb-14">
        <h2 class="mb-4 text-xl font-semibold text-zinc-900 dark:text-zinc-100">{heading}</h2>
        {intro && <p class="mb-6 max-w-prose text-zinc-600 dark:text-zinc-400">{intro}</p>}
        <ul class="divide-y divide-zinc-200 dark:divide-zinc-800">
          {items.map(({ title, url, description, authors }) => (
            <li class="py-4 first:pt-0">
              <a href={url} class="font-medium text-zinc-900 hover:text-accent dark:text-zinc-100 dark:hover:text-accent-dark" rel="noopener" target="_blank">
                {title} ↗
              </a>
              {authors && <p class="mt-0.5 text-sm text-zinc-500">by {authors}</p>}
              <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
